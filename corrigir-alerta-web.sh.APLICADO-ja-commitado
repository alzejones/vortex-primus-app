#!/bin/bash
set -e
cd /home/p/vortex-primus-app

CLIENT_DIET=$(find . -name "client-diet.tsx" -not -path "*/node_modules/*" | head -1)
if [ -z "$CLIENT_DIET" ]; then
  echo "ERRO: client-diet.tsx não encontrado."
  exit 1
fi
echo "Arquivo: $CLIENT_DIET"

python3 - "$CLIENT_DIET" << 'PYEOF'
import sys
path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    content = f.read()

old = '''      Alert.alert(
        "Não foi possível gerar o plano",
        err?.message ?? "Tente novamente em instantes."
      );'''

new = '''      const msg = err?.message ?? "Tente novamente em instantes.";
      if (Platform.OS === "web") {
        window.alert(`Não foi possível gerar o plano\\n\\n${msg}`);
      } else {
        Alert.alert("Não foi possível gerar o plano", msg);
      }'''

if old not in content:
    print(">>> AVISO: trecho original não encontrado — nada foi alterado. Precisa editar manualmente.")
    sys.exit(1)
else:
    content = content.replace(old, new)
    with open(path, "w", encoding="utf-8") as f:
        f.write(content)
    print(">>> OK: alerta corrigido para funcionar também na web.")
PYEOF

git add "$CLIENT_DIET"
git commit -m "fix: mostra erro do Gerar Plano com IA tambem na web (Alert.alert nao funciona em web)"
git push origin main

echo ""
echo "Pronto. Deploy automatico deve rodar na Vercel em instantes."
echo "Depois disso, clique em 'Gerar Plano com IA' de novo e me mande a mensagem exata do popup."
